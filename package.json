{
  "name": "searweb",
  "version": "0.2.0",
  "description": "Unified web search with DDG, SearXNG, Wikipedia, and LLM research. Dual-mode: MCP Server + CLI.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "searweb": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.js",
    "lint": "echo 'No linter configured'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "search",
    "web",
    "duckduckgo",
    "searxng",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.14.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dockerode": "^4.0.4",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.3.0",
    "openai": "^4.85.4",
    "ora": "^8.2.0",
    "socks-proxy-agent": "^8.0.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist",
    "scripts",
    "rules",
    "README.md",
    "README.zh.md",
    "CONFIG.md",
    "SETUP.md",
    "config.template.json"
  ],
  "engines": {
    "node": ">=20"
  }
}
